# `//submodules/GatewayProtocol` loads `@protobuf//bazel:proto_library.bzl`, and rules_swift's
# `swift_proto_library` is built on the same `ProtoInfo`. rules_swift already puts protobuf in the
# module graph, but a repository is only visible to the main repository when the ROOT module
# declares it - otherwise the load fails with `No repository visible as '@protobuf' from main
# repository`. Pinned to rules_swift's own version so both agree on one ProtoInfo definition.
bazel_dep(name = "protobuf", version = "34.0.bcr.1")

